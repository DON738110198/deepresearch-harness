{
  "provider": {
    "kind": "openai_compatible",
    "model": "replace-with-your-model-id",
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY",
    "timeout_seconds": 60,
    "thinking_mode": null,
    "pricing": {
      "input_per_million_usd": 0.0,
      "input_cache_hit_per_million_usd": 0.0,
      "input_cache_miss_per_million_usd": 0.0,
      "output_per_million_usd": 0.0
    }
  },
  "search": {
    "kind": "duckduckgo",
    "timeout_seconds": 20,
    "max_results_per_query": 5,
    "max_download_bytes": 1000000,
    "max_excerpt_characters": 1200
  },
  "run": {
    "max_evidence": 6,
    "budget": {
      "max_total_tokens": null,
      "max_estimated_cost_usd": null,
      "max_llm_calls": 3,
      "max_output_tokens_per_call": 2048
    }
  }
}
